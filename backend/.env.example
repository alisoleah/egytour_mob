# Database
DATABASE_URL=postgresql://user:password@localhost:5432/egytour

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AI
GEMINI_API_KEY=your-gemini-api-key

# Server
PORT=3000
NODE_ENV=development

# Tour_os PMS integration (hotel pass codes)
# Public URL of the Tour_os API. When empty, pass activation runs in dev mode:
# codes listed in DEV_PASS_CODES activate the VIP tier locally. Localhost and
# private hosts are rejected — tunnel local Tour_os instances for development.
TOUROS_API_URL=
TOUROS_SERVICE_EMAIL=
TOUROS_SERVICE_PASSWORD=
DEV_PASS_CODES=EG-TESTTEST
