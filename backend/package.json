    "drizzle-orm": "^0.29.3",
    "postgres": "^3.4.3",
    "zod": "^3.22.4",
    "bcrypt": "^5.1.1",
    "@google/generative-ai": "^0.1.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/bcrypt": "^5.0.2",
    "tsx": "^4.7.0",
    "drizzle-kit": "^0.20.9"
